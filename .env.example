# ============================================================
# Copy this to .env.local — NEVER commit .env.local to git
# ============================================================

# Your Firebase / Firestore project ID (required)
# Found in Firebase Console → Project Settings → General
NEXT_PUBLIC_FIREBASE_PROJECT_ID=clinio-ai

# Your deployed site URL — used for Open Graph, sitemap, robots.txt
# No trailing slash. Use https in production.
NEXT_PUBLIC_BASE_URL=https://clinio-ai.com

# Google Search Console verification code (optional)
# Get from: https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Twitter/X handle for Twitter Card meta tags (optional)
NEXT_PUBLIC_TWITTER_HANDLE=@clinioai
